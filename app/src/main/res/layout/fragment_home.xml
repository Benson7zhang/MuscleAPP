<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/bg_home_gradient"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingTop="12dp"
        android:paddingEnd="16dp"
        android:paddingBottom="8dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_open_home_drawer"
                style="@style/Widget.MuscleFit.Button.HomeControl"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1"
                android:textAllCaps="false" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_gender_switch"
                style="@style/Widget.MuscleFit.Button.HomeControl"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:textAllCaps="false" />
        </LinearLayout>

        <TextView
            android:id="@+id/tv_home_body_map_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:gravity="center"
            android:text="@string/home_body_map_title"
            android:textColor="@color/mf_on_surface"
            android:textSize="30sp"
            android:textStyle="bold" />

        <FrameLayout
            android:id="@+id/body_map_panel"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="10dp"
            android:layout_weight="1">

            <ImageView
                android:id="@+id/iv_body_map_background"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:adjustViewBounds="true"
                android:contentDescription="@string/body_map_content_description_default"
                android:scaleType="fitCenter"
                android:src="@drawable/body_map_front" />

            <com.musclefit.app.ui.home.BodyMapView
                android:id="@+id/body_map_overlay"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />
        </FrameLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_toggle_body_side"
            style="@style/Widget.MuscleFit.Button.HomeSwitch"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:layout_gravity="end"
            android:layout_marginTop="8dp"
            android:minWidth="104dp"
            android:text="@string/body_map_switch_back"
            android:textAllCaps="false" />

    </LinearLayout>

</FrameLayout>
